{
  "name": "oneapply",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:extension": "pnpm --filter @oneapply/extension dev",
    "dev:dashboard": "pnpm --filter @oneapply/dashboard dev",
