# Backend
DATABASE_URL=postgres://oneapply:oneapply@localhost:5432/oneapply?sslmode=disable
PORT=8080

# Generate with: openssl rand -hex 32
# JWT_SECRET must be at least 16 chars. TOKEN_ENCRYPTION_KEY must decode to exactly 32 bytes (64 hex chars).
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Google OAuth (Phase 1)
# Create an OAuth 2.0 Client (Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/api/auth/google/callback
# Required scopes are set in code (openid, email, profile, gmail.send, gmail.readonly).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Where to redirect after successful login (dashboard root)
DASHBOARD_URL=http://localhost:5173

# Cookie flags. Set COOKIE_SECURE=true in production (HTTPS only).
COOKIE_SECURE=false

# LLM (Phase 4)
ANTHROPIC_API_KEY=

# Apollo (Phase 3)
APOLLO_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8080
